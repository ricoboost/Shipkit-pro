// ShipKit - Complete Database Schema
// Supports: Multi-tenancy, Credits, Blog, Newsletter, Referrals, Audit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== AUTH ==============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          Role      @default(USER)

  // User status for admin management
  status        UserStatus @default(ACTIVE)
  bannedAt      DateTime?
  bannedReason  String?
  lastLoginAt   DateTime?
  loginCount    Int        @default(0)

  // SECURITY: Soft delete for audit trail and data recovery
  deletedAt     DateTime?
  deletedReason String?

  // Provider info
  authProvider  AuthProvider @default(NEXTAUTH)
  referralCode  String?   @unique @default(cuid())

  // Payment provider customer ID
  stripeCustomerId String? @unique

  // Relations
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  aiUsage       AIUsage[]
  creditBalance CreditBalance?

  // Organizations
  ownedOrganizations Organization[]
  memberships       OrganizationMember[]

  // Content
  blogPosts     BlogPost[]

  // Referrals
  referrals     Referral[] @relation("Referrals")
  referredBy    Referral?  @relation("ReferredBy")

  // Onboarding
  onboardingCompleted Boolean @default(false)

  // Language preference
  preferredLanguage String @default("en")

  // Two-Factor Authentication
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============== ORGANIZATIONS ==============

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?

  // Owner
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  // Billing
  stripeCustomerId String? @unique
  plan             Plan    @default(FREE)

  // Settings
  settings    Json?

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  aiUsage     AIUsage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  expiresAt      DateTime

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@map("organization_invitations")
}

// ============== BILLING ==============

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique

  // Provider-agnostic
  provider               PaymentProvider
  providerCustomerId     String   @unique
  providerSubscriptionId String?  @unique
  providerPriceId        String?

  // Status
  status                 SubscriptionStatus @default(INACTIVE)
  plan                   Plan     @default(FREE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// ============== CREDITS SYSTEM ==============

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    CreditLedger[]

  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

model CreditLedger {
  id          String      @id @default(cuid())
  balanceId   String
  amount      Int         // Positive = grant, negative = burn
  type        CreditType
  description String?
  metadata    Json?
  expiresAt   DateTime?

  balance     CreditBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())

  @@index([balanceId, createdAt])
  @@map("credit_ledger")
}

model CreditPackage {
  id          String   @id @default(cuid())
  name        String
  credits     Int
  price       Float    // in cents
  currency    String   @default("usd")
  active      Boolean  @default(true)

  // Provider price IDs
  stripePriceId       String?
  lemonsqueezyVariantId String?
  polarPriceId        String?

  createdAt   DateTime @default(now())

  @@map("credit_packages")
}

// ============== AI ==============

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  prefix    String   // First 8 chars for display (sk_live_xxxx...)
  lastUsed  DateTime?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("api_keys")
}

model AIUsage {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String?
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cost             Float    @default(0) // in cents
  creditsUsed      Int      @default(0)
  type             AIUsageType
  metadata         Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

// ============== BLOG ==============

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  featured    Boolean  @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  categories  BlogCategory[]
  tags        BlogTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]

  @@map("blog_tags")
}

// ============== NEWSLETTER ==============

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  confirmed     Boolean  @default(false)
  confirmToken  String?  @unique

  // Segmentation
  source        String?  // "waitlist", "footer", "popup"
  tags          String[] @default([])

  unsubscribedAt DateTime?

  createdAt     DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============== REFERRALS ==============

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique

  // Commission tracking
  status          ReferralStatus @default(PENDING)
  commissionRate  Float          @default(0.20) // 20%
  totalEarned     Float          @default(0)
  paidOut         Float          @default(0)

  referrer     User     @relation("Referrals", fields: [referrerId], references: [id])
  referred     User     @relation("ReferredBy", fields: [referredId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("referrals")
}

// ============== AUDIT LOG ==============

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "user.created", "subscription.updated", etc.
  resource   String   // "user", "subscription", "organization"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============== WEBHOOK LOG (IDEMPOTENCY) ==============

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String   @unique // Provider's event ID for idempotency
  provider   PaymentProvider
  eventType  String
  status     String   @default("processed") // processed, failed, skipped
  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([webhookId])
  @@index([provider, createdAt])
  @@map("webhook_logs")
}

// ============== APP CONFIG ==============

model AppConfig {
  id        String   @id @default("default")

  // Providers
  authProvider    AuthProvider    @default(NEXTAUTH)
  paymentProvider PaymentProvider @default(STRIPE)
  aiProvider      AIProvider      @default(OPENROUTER)

  // Theme (JSON)
  theme     Json?

  // Site settings
  siteName        String   @default("ShipKit")
  siteIcon        String   @default("Rocket")
  siteUrl         String?
  siteDescription String?

  // Features toggles
  waitlistMode    Boolean  @default(false)
  maintenanceMode Boolean  @default(false)

  // Internationalization
  defaultLanguage String @default("en")

  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ============== WAITLIST PAGE BUILDER ==============

model WaitlistPage {
  id              String   @id @default("default")

  // Page configuration stored as JSON
  config          Json     // WaitlistPageConfig type

  // SEO metadata
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  // Publishing
  published       Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("waitlist_pages")
}

// ============== ENUMS ==============

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthProvider {
  NEXTAUTH
  SUPABASE
  BETTERAUTH
}

enum PaymentProvider {
  STRIPE
  LEMONSQUEEZY
  POLAR
}

enum AIProvider {
  OPENROUTER
  VERCEL
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum CreditType {
  PURCHASE      // Bought credits
  GRANT         // Free credits (signup bonus, promo)
  BURN          // Used credits
  EXPIRY        // Expired credits
  REFUND        // Refunded credits
}

enum AIUsageType {
  CHAT
  COMPLETION
  EMBEDDING
  IMAGE
}

enum ReferralStatus {
  PENDING
  ACTIVE
  PAID
  CANCELLED
}

// ============== IMPERSONATION ==============

model ImpersonationLog {
  id          String    @id @default(cuid())
  adminId     String
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  reason      String?

  @@index([adminId, startedAt])
  @@index([userId, startedAt])
  @@map("impersonation_logs")
}

// ============== SESSION REVOCATION ==============

model RevokedSession {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique // JWT ID or session token hash
  revokedAt DateTime @default(now())
  reason    String?  // "logout", "password_change", "admin_revoke"
  expiresAt DateTime // Original session expiry (for cleanup)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt]) // For cleanup job
  @@map("revoked_sessions")
}
