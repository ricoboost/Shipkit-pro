# ShipKit Environment Variables
# Copy this to .env.local and fill in your values
#
# QUICK START - Just need these 2 to run:
#   1. DATABASE_URL - Get free DB at: supabase.com, neon.tech, or planetscale.com
#   2. AUTH_SECRET - Generate with: openssl rand -base64 32
#
# Then run: npm run db:push && npm run dev

# ============== APP ==============
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ShipKit"

# ============== DATABASE (Required) ==============
# Get a free PostgreSQL database from:
#   - Supabase: supabase.com (recommended)
#   - Neon: neon.tech
#   - PlanetScale: planetscale.com (MySQL)
DATABASE_URL="postgresql://user:password@localhost:5432/shipkit"

# ============== AUTH (Required) ==============
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# ============== AUTH PROVIDER ==============
# Options: nextauth | supabase | betterauth
AUTH_PROVIDER="nextauth"
NEXT_PUBLIC_AUTH_PROVIDER="nextauth"

# NextAuth URL (if AUTH_PROVIDER=nextauth)
NEXTAUTH_URL="http://localhost:3000"

# Supabase (if AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Better Auth (if AUTH_PROVIDER=betterauth)
BETTER_AUTH_SECRET=""

# OAuth Providers (works with all auth providers)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ============== PAYMENT PROVIDER ==============
# Options: stripe | lemonsqueezy | polar
PAYMENT_PROVIDER="stripe"

# Stripe (if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Monthly subscription price IDs
NEXT_PUBLIC_STRIPE_STARTER_MONTHLY_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=""
NEXT_PUBLIC_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
# Yearly subscription price IDs
NEXT_PUBLIC_STRIPE_STARTER_YEARLY_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=""
NEXT_PUBLIC_STRIPE_ENTERPRISE_YEARLY_PRICE_ID=""

# LemonSqueezy (if PAYMENT_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STARTER_VARIANT_ID=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=""

# Polar (if PAYMENT_PROVIDER=polar)
POLAR_ACCESS_TOKEN=""
POLAR_ORGANIZATION_ID=""
POLAR_WEBHOOK_SECRET=""
POLAR_STARTER_PRICE_ID=""
POLAR_PRO_PRICE_ID=""
POLAR_ENTERPRISE_PRICE_ID=""

# ============== AI PROVIDER ==============
# Options: openrouter | vercel
AI_PROVIDER="openrouter"

# OpenRouter (if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=""

# Vercel AI / Direct APIs (if AI_PROVIDER=vercel)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# ============== EMAIL ==============
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ============== STORAGE ==============
# Options: r2 | s3 | supabase
STORAGE_PROVIDER="r2"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# ============== ANALYTICS (Optional) ==============
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ============== SECURITY ==============
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ============== NOTIFICATIONS (Optional) ==============
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""

# ============== CREDITS ==============
# Signup bonus credits
SIGNUP_BONUS_CREDITS="100"
